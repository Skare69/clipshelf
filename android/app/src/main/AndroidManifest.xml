<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Clipshelf"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Native share-sheet receiver. text/plain only; validates and persists
             before confirming, then returns to the source app. -->
        <activity
            android:name=".ui.ShareReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_to_clipshelf"
            android:noHistory="true"
            android:taskAffinity="dev.clipshelf.app.share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.SetupActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.LibraryActivity" android:exported="false" />
        <activity android:name=".ui.EntryActivity" android:exported="false" />
        <activity android:name=".ui.AssetActivity" android:exported="false" />
        <activity android:name=".ui.CollectionsActivity" android:exported="false" />
        <activity android:name=".ui.CollectionDetailActivity" android:exported="false" />
        <activity android:name=".ui.OutboxActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
