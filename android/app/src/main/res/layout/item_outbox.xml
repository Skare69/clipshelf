<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Parcel.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/outbox_route_onphone"
                android:textAppearance="@style/TextAppearance.Parcel.T1"
                android:textColor="@color/ink2" />

            <View
                android:id="@+id/outbox_dot_a"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/dot_current" />

            <View
                android:id="@+id/outbox_line"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="@color/hair" />

            <View
                android:id="@+id/outbox_dot_b"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/dot_todo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/outbox_route_delivered"
                android:textAppearance="@style/TextAppearance.Parcel.T1"
                android:textColor="@color/ink2" />
        </LinearLayout>

        <TextView
            android:id="@+id/outbox_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Parcel.T2" />

        <TextView
            android:id="@+id/outbox_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="@style/TextAppearance.Parcel.T3" />

        <TextView
            android:id="@+id/outbox_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Parcel.T2Body"
            android:textColor="@color/ink2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/outbox_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Parcel.T1Num"
                android:textColor="@color/ink3" />

            <TextView
                android:id="@+id/outbox_attempts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Parcel.T1Num"
                android:textColor="@color/ink3" />
        </LinearLayout>

        <TextView
            android:id="@+id/outbox_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Parcel.T2"
            android:textColor="@color/err"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
