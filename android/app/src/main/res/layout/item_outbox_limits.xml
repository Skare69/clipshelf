<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/outbox_load_older"
        style="@style/Widget.Parcel.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/outbox_load_older"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/limits_title"
        android:textAppearance="@style/TextAppearance.Parcel.T1"
        android:textColor="@color/ink2" />

    <TextView
        android:id="@+id/outbox_limits_capacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Parcel.T1Num"
        android:textColor="@color/ink3" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/limits_text"
        android:textAppearance="@style/TextAppearance.Parcel.T3"
        android:textColor="@color/ink2" />
</LinearLayout>
