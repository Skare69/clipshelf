<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/appbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/account_section"
                android:textAppearance="@style/TextAppearance.Parcel.T1"
                android:textColor="@color/ink2" />

            <TextView
                android:id="@+id/settings_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Parcel.T3Title" />

            <TextView
                android:id="@+id/settings_instance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Parcel.T2Body"
                android:textColor="@color/ink2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/default_collection_section"
                android:textAppearance="@style/TextAppearance.Parcel.T1"
                android:textColor="@color/ink2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/default_collection_hint"
                android:textAppearance="@style/TextAppearance.Parcel.T2Body"
                android:textColor="@color/ink2" />

            <Spinner
                android:id="@+id/settings_default_collection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/settings_default_apply"
                style="@style/Widget.Parcel.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/collection_set_default" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/endpoint_section"
                android:textAppearance="@style/TextAppearance.Parcel.T1"
                android:textColor="@color/ink2" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Parcel.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/endpoint_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/settings_endpoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="url"
                    android:inputType="textUri"
                    android:textAppearance="@style/TextAppearance.Parcel.T3" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/settings_endpoint_apply"
                style="@style/Widget.Parcel.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/endpoint_update" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/limits_section"
                android:textAppearance="@style/TextAppearance.Parcel.T1"
                android:textColor="@color/ink2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/limits_text"
                android:textAppearance="@style/TextAppearance.Parcel.T3"
                android:textColor="@color/ink2" />

            <Button
                android:id="@+id/settings_logout"
                style="@style/Widget.Parcel.Button.Text.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:minWidth="0dp"
                android:text="@string/action_logout" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottomnav" />
</LinearLayout>
