<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/outbox_retry"
            style="@style/Widget.Parcel.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/outbox_retry_now" />

        <Button
            android:id="@+id/outbox_clear"
            style="@style/Widget.Parcel.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/outbox_clear_delivered" />
    </LinearLayout>

    <!-- In the list header, not over the list: the limits footer stays readable. -->
    <TextView
        android:id="@+id/outbox_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:text="@string/outbox_empty"
        android:textAppearance="@style/TextAppearance.Parcel.T3"
        android:textColor="@color/ink2"
        android:visibility="gone" />
</LinearLayout>
