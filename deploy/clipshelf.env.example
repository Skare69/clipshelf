# Clipshelf compose environment. Copy to `.env` next to compose.yaml and fill
# in real values. `.env` is git-ignored and docker-ignored — never commit it.

# Required: an existing, versioned image (GHCR tag you published) — or a local
# tag you built yourself for verification:
#   CLIPSHELF_IMAGE=clipshelf:local docker compose build
CLIPSHELF_IMAGE=

# Required: numeric UID/GID that owns the host data directory (unprivileged
# runtime identity; PUID/PGID do nothing on this image).
CLIPSHELF_UID=568
CLIPSHELF_GID=568

# Required: local dataset directory mounted at /data (ZFS dataset mountpoint,
# not NFS/SMB — SQLite WAL needs local filesystem semantics).
CLIPSHELF_DATA_DIR=

# Required application configuration.
CLIPSHELF_ORIGIN=
# Required: comma-separated hostnames the server answers on, LAN name first,
# then the tailnet name (e.g. clipshelf.home.arpa,clipshelf.tail1234.ts.net).
CLIPSHELF_ALLOWED_HOSTS=
CLIPSHELF_SECRET_KEY=
# LAN port published on the host; the container always listens on 8000.
CLIPSHELF_PORT=8000
# Development only — never set on the NAS (skips production gates).
# CLIPSHELF_DEBUG=1

# Only if you independently verified a fixed SQLite build that is older than
# 3.51.3 (escape hatch mirrored by app settings). Leave unset otherwise.
# CLIPSHELF_SQLITE_VERIFIED=1

# SMTP relay for invitations and password recovery. Ordinary login does not
# need SMTP; with host unset the app falls back to the console backend, which
# is development-only. Production onboarding/recovery needs a real relay.
CLIPSHELF_SMTP_HOST=
CLIPSHELF_SMTP_PORT=587
CLIPSHELF_SMTP_USER=
CLIPSHELF_SMTP_PASSWORD=
CLIPSHELF_SMTP_USE_TLS=1
CLIPSHELF_SMTP_USE_SSL=
CLIPSHELF_EMAIL_FROM=

# One-time: email of the initial administrator for `bootstrap`.
CLIPSHELF_ADMIN_EMAIL=
