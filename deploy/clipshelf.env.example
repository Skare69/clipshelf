# Clipshelf compose environment. Copy to `.env` next to compose.yaml and fill
# in real values. `.env` is git-ignored and docker-ignored — never commit it.
# First run: docker compose up -d, then complete the setup wizard in the web
# UI — everything below the REQUIRED block is optional.

# ---- required ----

# An existing, versioned image (GHCR tag you published) — or a local tag you
# built yourself for verification:
#   CLIPSHELF_IMAGE=clipshelf:local docker compose build
CLIPSHELF_IMAGE=

# Numeric UID/GID that owns the host data directory (unprivileged runtime
# identity; PUID/PGID do nothing on this image).
CLIPSHELF_UID=568
CLIPSHELF_GID=568

# Local dataset directory mounted at /data (ZFS dataset mountpoint, not
# NFS/SMB — SQLite WAL needs local filesystem semantics).
CLIPSHELF_DATA_DIR=

# LAN port published on the host; the container always listens on 8000.
CLIPSHELF_PORT=8000

# ---- optional ----

# Secret key: generated into the data dir when unset.
# CLIPSHELF_SECRET_KEY=

# Hostnames the server answers on; unset defaults to * (fine on a LAN behind
# a VPN).
# CLIPSHELF_ALLOWED_HOSTS=

# Base URL for account-mail links (e.g. https://nas.example:8443). An https://
# value enables HTTPS hardening; unset keeps plain LAN HTTP working.
# CLIPSHELF_ORIGIN=

# CSRF protection is off by default. Setting =1 requires CLIPSHELF_ORIGIN or
# CLIPSHELF_ALLOWED_HOSTS.
# CLIPSHELF_CSRF=1

# Development only — never set on the NAS (skips production gates).
# CLIPSHELF_DEBUG=1

# Only if you independently verified a fixed SQLite build that is older than
# 3.51.3 (escape hatch mirrored by app settings). Leave unset otherwise.
# CLIPSHELF_SQLITE_VERIFIED=1

# SMTP relay for invitations and password recovery. Ordinary login does not
# need SMTP; with host unset the app falls back to the console backend, which
# is development-only. Production onboarding/recovery needs a real relay.
CLIPSHELF_SMTP_HOST=
CLIPSHELF_SMTP_PORT=587
CLIPSHELF_SMTP_USER=
CLIPSHELF_SMTP_PASSWORD=
CLIPSHELF_SMTP_USE_TLS=1
CLIPSHELF_SMTP_USE_SSL=
CLIPSHELF_EMAIL_FROM=

# Optional TypeSafe screening key; without it guardrails are skipped
# (fail-open) and interpretation behaves exactly as before.
# TYPESAFE_API_KEY=
# Optional model pin for screening.
# TYPESAFE_MODEL=

# CLI recovery only: on a normal first run the setup wizard creates the first
# admin. `docker compose --profile ops run --rm bootstrap` needs this email.
# CLIPSHELF_ADMIN_EMAIL=
